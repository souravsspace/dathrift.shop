{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "dathrift-dev-foundation",
	"main": "src/foundation/entry.ts",
	"compatibility_date": "2026-10-04",
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		"ALLOWED_HOST": "dathrift-dev-foundation.souravsspace.workers.dev",
		"ACCOUNT_ID": "ec8d4a8a8415976daf6f8479a89aa529",
		"DATABASE_ID": "00000000-0000-0000-0000-000000000000"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dathrift-dev-primary",
			"database_id": "00000000-0000-0000-0000-000000000000"
		}
	],
	"r2_buckets": [
		{
			"binding": "BACKUP_BUCKET",
			"bucket_name": "dathrift-dev-d1-backups"
		}
	],
	"send_email": [{ "name": "EMAIL" }],
	"secrets": {
		"required": ["STAFF_EMAILS", "D1_REST_API_TOKEN", "ALERT_EMAIL", "ALERT_FROM_EMAIL"]
	},
	"workflows": [
		{
			"name": "dathrift-dev-d1-backup",
			"binding": "BACKUP_WORKFLOW",
			"class_name": "D1BackupWorkflow",
			"schedules": ["*/30 * * * *"]
		}
	]
}
