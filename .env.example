# Nonproduction setup only. Copy this file to .env.local and fill in the
# blank values there. .env.local is Git-ignored; never commit it or paste its
# contents, passwords, MFA codes, or tokens into chat.
#
# These names are private setup inputs, not automatically deployed
# Worker bindings. After the protected preview is approved, the owner and
# moderator addresses will form the STAFF_EMAILS Worker allowlist, and the
# export token will be installed as the D1_REST_API_TOKEN Worker secret.

# Exact Google email address the owner will personally use for Cloudflare
# Access sign-in. Ask the owner; do not use a display name or a shared login.
OWNER_EMAIL=

# Exact Google email address the moderator will personally use for Cloudflare
# Access sign-in. Ask the moderator; they must complete their own sign-in/MFA.
MODERATOR_EMAIL=

# Hostname of the staff-only app, without https:// or a path. Planned:
# admin.dathrift.shop. This must match the Access-protected custom hostname;
# an alternate Worker or preview URL is intentionally denied.
STAFF_HOST=

# Comma-separated exact Google email addresses allowed to use staff routes.
# Use the owner and moderator addresses above after both are confirmed.
# This is also a server-side allowlist; Access policy alone is not sufficient.
STAFF_EMAILS=

# Cloudflare Zero Trust team domain including https://, such as
# https://YOUR-TEAM.cloudflareaccess.com. Find it in Zero Trust settings.
# The Worker validates JWT signatures against this team's Access keys.
ACCESS_TEAM_DOMAIN=

# Access application Audience (AUD) tag for the staff app. Find it in Zero
# Trust > Access > Applications > the staff application > Overview. This is
# an identifier, not a password; use the actual app's value, not a guess.
ACCESS_AUD=

# Create a custom Cloudflare API token in the confirmed account
# ec8d4a8a8415976daf6f8479a89aa529: Dashboard > Manage Account > API Tokens
# (or My Profile > API Tokens for a user token) > Create Token. Grant only
# Account > D1 > Read and restrict its resources to this account. D1 Read is
# account-scoped, not limited to the test database; the backup Worker code
# targets only dathrift-dev-primary. Copy the token when shown once.
# Do not use a Global API Key or grant D1 Edit/Write.
# https://developers.cloudflare.com/fundamentals/api/get-started/create-token/
# https://developers.cloudflare.com/fundamentals/api/reference/permissions/
D1_EXPORT_TOKEN=

# Owner-controlled mailbox intended to receive failed/stale backup alerts.
# Enter the address you want to verify in Cloudflare. This is a planning input:
# the alert delivery path is not configured yet, and filling it does not send
# mail or authorize Email Service/DNS changes.
ALERT_EMAIL=

# Sender address on a domain onboarded to Cloudflare Email Service (for
# example, an alerts@ address on a domain you control). Find or create it in
# Dashboard > Compute > Email Service > Email Sending, but do not onboard a
# domain or change DNS until separately approved. The sender must be valid
# before a real alert can be sent.
# https://developers.cloudflare.com/email-service/get-started/send-emails/
ALERT_FROM_EMAIL=

# No Google OAuth client ID/secret is requested here. The account currently has
# no Google Access identity provider; creating a Google-side OAuth app needs
# separate owner approval. Never put OAuth credentials in this example file.
